{
  "name": "backbench",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // One Worker serves the static client too (Workers static assets are free) — no separate Pages project.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "CREW", "class_name": "Crew" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Crew"] }],
  // GET /api/rooms/:code — 30 lookups/min per IP (PRD §16)
  "ratelimits": [{ "name": "LOOKUPS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
